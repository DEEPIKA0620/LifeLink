# LifeLink Backend Environment Variables

PROJECT_NAME="LifeLink Emergency Blood & Medicine Locator System"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (MySQL preferred; SQLite fallback if unconfigured)
DATABASE_URL=sqlite:///./lifelink.db

# Security & JWT Authentication
JWT_SECRET_KEY=lifelink_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-party Integrations (Optional)
EMAIL_API_KEY=
SMS_API_KEY=
MAP_API_KEY=

# CORS Configuration
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
