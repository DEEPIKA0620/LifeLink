# LifeLink Backend Environment Variables (Example Template)

PROJECT_NAME="LifeLink Emergency Blood & Medicine Locator System"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Option A: Local SQLite database
DATABASE_URL=sqlite:///./lifelink.db
# Option B: Supabase / PostgreSQL Direct Connection
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Integration (Server-side)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Security & JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-party Integrations (Optional)
EMAIL_API_KEY=
SMS_API_KEY=
MAP_API_KEY=

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
